# Kanso Duo Local Environment
APP_NAME="Kanso Duo"
APP_ENV=development
PORT=8080
CORS_ALLOW_ORIGINS=*

# Database Configuration
# Set to 'postgres' for PostgreSQL Docker or 'sqlite' for local SQLite
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=kanso_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta
DB_PATH=kanso.db

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/duo/auth/google/callback
FRONTEND_URL=http://localhost:5173

LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
